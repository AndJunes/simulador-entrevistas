# =============================================================================
#  Simulador de Entrevistas — variables de entorno
# =============================================================================
#  cp .env.example .env   y completá los valores marcados con  ← COMPLETAR
#  El .env no se versiona (.gitignore). Solo figuran variables que el código lee.
#  Endpoints y precios verificados el 2026-10-11 (build.nvidia.com, OpenRouter /api/v1/models).
# =============================================================================


# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173


# -----------------------------------------------------------------------------
# Base de datos — Postgres + pgvector (docker compose)
# -----------------------------------------------------------------------------
POSTGRES_USER=simulador
POSTGRES_PASSWORD=                     # ← COMPLETAR (contraseña local, la elegís vos)
POSTGRES_DB=simulador
POSTGRES_HOST=localhost
POSTGRES_PORT=5432


# -----------------------------------------------------------------------------
# OpenRouter — LLM (análisis del puesto, preguntas, evaluación, repreguntas)
# Key: https://openrouter.ai/settings/keys
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=                    # ← COMPLETAR
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=http://localhost:5173          # atribución opcional en el dashboard
OPENROUTER_APP_TITLE=Simulador de Entrevistas

# Modelo fuerte para evaluar (la calidad del juicio es el riesgo principal) y uno barato
# para tareas simples. Precios por 1M de tokens entrada/salida (2026-10-11):
#   anthropic/claude-sonnet-5.5  US$2.00 / US$10.00
#   anthropic/claude-haiku-5.5   US$0.10 / US$0.50
LLM_EVALUATOR_MODEL=anthropic/claude-sonnet-5.5
LLM_FAST_MODEL=anthropic/claude-haiku-5.5

# Los Claude 5.5 en OpenRouter no aceptan "temperature": con require_parameters=true
# devuelve 404 "No endpoints found". Se controla con el razonamiento: low | medium | high.
LLM_EVALUATOR_REASONING_EFFORT=medium

# "deny" = solo proveedores que no guardan ni entrenan con los datos (CV y respuestas).
OPENROUTER_DATA_COLLECTION=deny


# -----------------------------------------------------------------------------
# NVIDIA — TTS y embeddings
# Key: https://build.nvidia.com → "Get API Key"
#
# Privacidad: los endpoints de build.nvidia.com son de prueba y sus términos dicen que
# el input/output se registra. Por eso el CV nunca se manda a NVIDIA, los embeddings
# solo indexan el corpus público y la transcripción de voz es local (Whisper).
# -----------------------------------------------------------------------------
NVIDIA_API_KEY=                        # ← COMPLETAR

# STT local: Whisper large-v3-turbo (MLX, Apple Silicon). El audio no sale de la máquina.
STT_LOCAL_MODEL=mlx-community/whisper-large-v3-turbo
STT_LOCAL_REVISION=a4aaeec0636e6fef84abdcbe3544cb2bf7e9f6fb   # commit fijado, no usar "main"
STT_LOCAL_WEIGHTS_SHA256_PREFIX=951ed3fc1203e6a6               # verificación de integridad de los pesos
STT_LOW_CONFIDENCE_THRESHOLD=0.5        # palabras debajo de esto → "posible error de transcripción"

# TTS: Magpie TTS Multilingual (https://build.nvidia.com/nvidia/magpie-tts-multilingual/api)
TTS_HTTP_URL=https://877104f7-e885-42b9-8de8-f6e4c6303969.invocation.api.nvcf.nvidia.com/v1/audio/synthesize
TTS_LANGUAGE_ES=es-US                  # Magpie no tiene es-ES ni es-AR
TTS_LANGUAGE_EN=en-US
TTS_SAMPLE_RATE_HZ=44100

# Embeddings: nemotron-3-embed-1b (API compatible con OpenAI).
# El modelo da 2048 dimensiones; los índices HNSW de pgvector admiten hasta 2000 para `vector`,
# así que se recorta a 1024 (soportado por el modelo) y se re-normaliza (L2).
# Si cambiás EMBEDDINGS_DIMENSIONS hay que reindexar el corpus.
EMBEDDINGS_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDINGS_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDINGS_DIMENSIONS=1024
EMBEDDINGS_TRUNCATE=END


# -----------------------------------------------------------------------------
# RAG y métricas de forma (rangos con fuente en backend/config/form_targets.yaml)
# -----------------------------------------------------------------------------
RAG_TOP_K=6
LONG_PAUSE_SECONDS=2.5                 # pausa "larga"
MIN_WORDS_TO_EVALUATE=5                # menos que esto → se pide repetir


# -----------------------------------------------------------------------------
# Telemetría: LangGraph instala langsmith; queda apagada
# -----------------------------------------------------------------------------
LANGSMITH_TRACING=false
